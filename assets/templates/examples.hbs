<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CalcPlot Examples</title>
    <link rel="stylesheet" href="./examples-bundle.css">
</head>
<body>
    <!-- Mobile Header -->
    <header class="mobile-header">
        <button class="mobile-menu-btn" onclick="toggleMobileMenu()">☰</button>
        <div class="mobile-title">CalcPlot Examples</div>
        <div></div>
    </header>

    <aside class="sidebar">
        <div class="sidebar-header">
            <h1>CalcPlot Examples</h1>
            <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Toggle Sidebar">☰</button>
            <button class="mobile-close-btn" onclick="toggleMobileMenu()">✕</button>
        </div>
        
        <nav>
            <ul class="nav-list">
                {{#each navigation}}
                <li class="nav-category">
                    <div class="nav-category-header" onclick="toggleCategory('{{categoryId}}')">
                        <div style="display: flex; align-items: center;">
                            <span class="nav-category-link" onclick="event.preventDefault(); window.location.hash='{{categoryId}}';">{{title}}</span>
                            <span class="nav-toggle" id="toggle-{{categoryId}}">▲</span>
                        </div>
                        <span class="nav-count">{{count}}</span>
                    </div>
                    <ul class="nav-examples" id="examples-{{categoryId}}">
                        {{#each examples}}
                        <li class="nav-example-item">
                            <a href="#{{id}}" class="nav-example-link">{{title}}</a>
                        </li>
                        {{/each}}
                    </ul>
                </li>
                {{/each}}
            </ul>
        </nav>
    </aside>

    <main class="main-content">
        {{#each examples}}
        <div class="category-group" id="{{categoryId}}" data-category="{{categoryId}}">
            <h2 class="category-title">{{title}}</h2>
            <div class="examples-container">
                {{#each examples}}
                <div class="example" id="{{id}}" data-category="{{../categoryId}}">
                    <div class="example-content">
                        <h3>{{title}}</h3>
                        
                        <div class="exec-block" data-code-id="{{codeId}}">
                            <div class="exec-content">
                                <button class="copy-button" onclick="copyCode('{{codeId}}')" title="Copy code">
                                    📋
                                </button>
                                <pre><code class="language-javascript">{{{highlightedCode}}}</code></pre>
                            </div>
                            <div id="calcplot-{{codeId}}" class="calcplot-container"></div>
                        </div>
                        
                        <script type="text/x-calcplot-example" id="{{codeId}}">
{{{rawCode}}}
                        </script>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/each}}
    </main>

    <script src="/calcplot.js"></script>
    <script>
        // Mobile menu toggle
        function toggleMobileMenu() {
            const sidebar = document.querySelector('.sidebar');
            sidebar.classList.toggle('mobile-open');
        }

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.querySelector('.sidebar');
            const mobileHeader = document.querySelector('.mobile-header');
            
            if (window.innerWidth <= 768 && 
                !sidebar.contains(event.target) && 
                !mobileHeader.contains(event.target) &&
                sidebar.classList.contains('mobile-open')) {
                sidebar.classList.remove('mobile-open');
            }
        });

        // Export CalcPlot functions to window
        if (typeof CalcPlot !== 'undefined') {
            window.defineIVP = CalcPlot.defineIVP;
            window.simulate = CalcPlot.simulate;
            window.explore = CalcPlot.explore;
            window.compare = CalcPlot.compare;
            window.show = CalcPlot.show;
            window.view = CalcPlot.view;
            window.slider = CalcPlot.slider;
            window.defineModel = CalcPlot.defineModel;
            window.defineEvent = CalcPlot.defineEvent;
            window.defineController = CalcPlot.defineController;
        } else {
            console.error('CalcPlot not loaded!');
        }
    </script>
    <script src="./examples-exec.js"></script>
</body>
</html>
